# このファイルを .env にコピーして値を設定してください（.env は他人が読めない場所・権限で管理）

# 申請システム API（gas/api のデプロイ URL）とロボット用トークン
API_URL=https://script.google.com/macros/s/xxxxxxxx/exec
ROBOT_TOKEN=

# PrimeDrive ロボット用アカウント
PRIMEDRIVE_URL=https://primedrive.jp/v2/browse
PRIMEDRIVE_CORP_ID=
PRIMEDRIVE_LOGIN_ID=
PRIMEDRIVE_PASSWORD=

# 送付用フォルダ（ホームからのパス。申請ごとにこの下へフォルダを作成）
PRIMEDRIVE_BASE_FOLDER=外部送付

# ダウンロード回数の上限（空欄なら PrimeDrive の既定値）
DOWNLOAD_COUNT=

# ブラウザ：Windows では msedge（インストール済みの Edge を使用）。chromium も可
BROWSER_CHANNEL=msedge
# 画面を表示して動作を確認したいときは false
HEADLESS=true

# ログ・スクリーンショットの保存先
LOG_DIR=./logs
